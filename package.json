{
  "name": "wanderpeak",
  "version": "1.0.0",
  "private": true,
  "description": "WanderPeak mountain travel landing page",
  "scripts": {
    "build": "npm run clean && npm run build:css && npm run build:js && npm run copy:html",

    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",

    "build:css": "esbuild style.css --minify --outfile=dist/style.css",

    "build:js": "esbuild script.js --minify --outfile=dist/script.js",

    "copy:html": "node -e \"require('fs').mkdirSync('dist',{recursive:true}); require('fs').copyFileSync('index.html','dist/index.html')\""
  },

  "devDependencies": {
    "esbuild": "0.25.9"
  }
}